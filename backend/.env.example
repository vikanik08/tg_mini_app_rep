APP_NAME=TG MiniApp API
ENV=dev

DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/tg_miniapp

JWT_SECRET=replace-with-a-long-random-secret
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

TELEGRAM_BOT_TOKEN=put_bot_token_here
VK_APP_ID=put_vk_app_id_here
VK_APP_SECRET=put_vk_app_secret_here
ADMIN_SECRET=replace-with-admin-secret

DEBUG=true
ALLOW_DEV_LOGIN=true
RUN_NOTIFICATION_WORKER=true

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
